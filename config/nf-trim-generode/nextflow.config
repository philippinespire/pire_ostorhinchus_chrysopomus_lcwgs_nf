workDir = '/archive/carpenterlab/pire/pire_ostorhinchus_chrysopomus_lcwgs/GenErode_Och_GCA_049176735.1/work'

conda {
    enabled = true
    cacheDir = '/archive/carpenterlab/pire/pire_ostorhinchus_chrysopomus_lcwgs/GenErode_Och_GCA_049176735.1/conda/envs'
    useMamba = false
}

singularity {
    enabled = true
    autoMounts = true
}

process {
    executor = 'slurm'
    queue = 'main'

    // Wahab schedules main-partition jobs by CPU cores rather than memory.
    // Keep BWA jobs off suspect nodes and prevent jobs from other users
    // from sharing the nodes used by these tasks.
    withName: 'BWA.*' {
        cpus = 4
        memory = { 32.GB * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 1
        maxErrors = '-1'
        clusterOptions = '--exclusive=user --exclude=d1-w6420a-11,d6-w6420b-05'
    }
}
