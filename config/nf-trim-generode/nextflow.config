workDir = '/archive/carpenterlab/pire/pire_ostorhinchus_chrysopomus_lcwgs/GenErode_Och_GCA_049176735.1/work'

conda {
    enabled = true
    cacheDir = '/archive/carpenterlab/pire/pire_ostorhinchus_chrysopomus_lcwgs/GenErode_Och_GCA_049176735.1/conda/envs'
    useMamba = false
}

singularity {
    enabled = true
    autoMounts = true
}

process {
    executor = 'slurm'
    queue = 'main'

    // samtools sort uses -m 4G per thread in the upstream BWA processes.
    // The upstream 16 GB request caused an allocation failure.
    withName: 'BWA.*' {
        cpus = 4
        memory = '32 GB'
    }
}
